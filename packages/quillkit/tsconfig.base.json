// What holds for all three of this package's programs, so a strictness raised here
// lands on the bin, the tests and the client rather than on whichever was remembered.
// Which half a program is — Node emit or browser resolution — is the config that
// extends this.
{
	"compilerOptions": {
		"target": "ES2022",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	}
}
