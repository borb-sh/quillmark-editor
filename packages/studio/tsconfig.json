{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true
	},
	// The client, which is the whole package. The Vite config that builds it runs in
	// Node rather than a browser and answers to `tsconfig.check.json`.
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
