// The Vite config's type check. The client answers to `tsconfig.json` under
// `svelte-check`; the config that builds it runs in Node, reaches the packer, and is
// checked by nothing else.
{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true
	},
	"include": ["vite.config.ts"]
}
