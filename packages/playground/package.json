{
	"name": "playground",
	"private": true,
	"version": "0.0.0",
	"description": "The manual harness for @quillmark/ui and @quillmark/quiver. Never published.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"quiver": "node scripts/build-quiver.mjs",
		"predev": "npm run quiver",
		"dev": "vite dev",
		"prebuild": "npm run quiver",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@quillmark/quiver": "*",
		"@quillmark/ui": "*"
	},
	"devDependencies": {
		"@quillmark/wasm": "0.98.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^26.1.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.7.0",
		"vite": "^6.0.0",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0"
	}
}
