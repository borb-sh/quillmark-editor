// The client's type check, run by `svelte-check`. The browser half of this package:
// DOM libs, bundler resolution, and Vite's own client types, none of which the bin's
// program wants. `tsconfig.json` builds the Node half and `tsconfig.check.json` reaches
// the configs beside it; one package, three programs, and no file is in two of them.
{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true
	},
	"include": ["client/**/*.ts", "client/**/*.svelte"]
}
