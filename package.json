{
	"name": "quillmark-js",
	"private": true,
	"description": "The JS tier downstream of the @quillmark/wasm artifact.",
	"license": "MIT",
	"type": "module",
	"packageManager": "npm@10.9.7",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w packages/ui",
		"build": "npm run build -w packages/ui",
		"check": "npm run check --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"check:canon": "node scripts/check-canon.mjs",
		"check:style": "node scripts/check-style.mjs"
	},
	"devDependencies": {
		"prettier": "^3.4.0",
		"prettier-plugin-svelte": "^3.3.0"
	}
}
