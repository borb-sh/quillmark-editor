// The bin, compiled. `src` alone: the client beside it is a browser program Vite
// builds, and a `client/` in this root would emit a second `dist/client` over the one
// `vite build` writes.
{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "src",
		"declaration": false,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["src/__tests__"]
}
