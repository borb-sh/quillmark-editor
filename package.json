{
	"name": "@quillmark/editor",
	"version": "0.0.0",
	"description": "Open-source editor + live preview components for Quillmark WASM consumers.",
	"license": "MIT",
	"type": "module",
	"packageManager": "npm@10.9.7",
	"engines": {
		"node": ">=22"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"svelte": "./dist/core/index.js",
			"default": "./dist/core/index.js"
		},
		"./preview": {
			"types": "./dist/preview/index.d.ts",
			"svelte": "./dist/preview/index.js",
			"default": "./dist/preview/index.js"
		},
		"./visual": {
			"types": "./dist/visual/index.d.ts",
			"svelte": "./dist/visual/index.js",
			"default": "./dist/visual/index.js"
		},
		"./source": {
			"types": "./dist/source/index.d.ts",
			"svelte": "./dist/source/index.js",
			"default": "./dist/source/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-package",
		"build:app": "svelte-kit sync && vite build",
		"preview": "npm run build:app && vite preview",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"test:e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:canon": "node scripts/check-canon.mjs",
		"check:geometry": "node scripts/check-geometry.mjs",
		"check:type": "node scripts/check-type.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@codemirror/lang-markdown": "6.4.0",
		"@codemirror/language": "6.11.3",
		"@codemirror/state": "6.5.2",
		"@codemirror/view": "6.38.6",
		"@lezer/highlight": "1.2.1",
		"@quillmark/wasm": "0.96.0",
		"bits-ui": "^2.0.0",
		"prosemirror-commands": "1.7.1",
		"prosemirror-history": "1.5.0",
		"prosemirror-inputrules": "1.5.1",
		"prosemirror-keymap": "1.2.3",
		"prosemirror-model": "1.25.11",
		"prosemirror-schema-list": "1.5.1",
		"prosemirror-state": "1.4.4",
		"prosemirror-transform": "1.12.0",
		"prosemirror-view": "1.42.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^26.1.1",
		"jsdom": "^29.1.1",
		"prettier": "^3.4.0",
		"prettier-plugin-svelte": "^3.3.0",
		"publint": "^0.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.7.0",
		"vite": "^6.0.0",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0",
		"vitest": "^4.1.10"
	}
}
