// What holds for all of this package's programs, so a strictness raised here lands on
// the bin, the tests and the client alike. Which half a program is — Node emit or
// browser resolution — is the config that extends this.
{
	"compilerOptions": {
		"target": "ES2022",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	}
}
